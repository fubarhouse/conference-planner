    {
      "startTime": "2023-01-21T01:00:00Z",
      "endTime": "2023-01-21T03:00:00Z",
      "duration": "P120M",
      "title": "ワークショップ (Workshop)",
      "location": "Location Workshop Room",
      "link": "https://drupal-camp2023.den-japan.org/workshop",
      "track": [],
      "speakers": null,
      "video_url": "",
      "full_description": "Hands-on workshop introducing Drupal to beginners. Participants registered tourism content about Iwakuni City and experienced creating website pages through content registration and no-code solutions. Target audience: people unfamiliar with Drupal, those wanting to create websites, those interested in no-code/low-code approaches. Programming knowledge not required. Own laptop required (tablets acceptable; smartphones not supported).",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T04:00:00Z",
