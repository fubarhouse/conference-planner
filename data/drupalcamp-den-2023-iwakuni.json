      ],
      "video_url": "",
      "full_description": "Opening address by Yoshihiko Fukuda, Mayor of Iwakuni City, Yamaguchi Prefecture.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T04:10:00Z",
      "endTime": "2023-01-21T04:20:00Z",
      "duration": "P10M",
      "title": "Driesからのビデオメッセージ (Video Message from Dries)",
      "location": "Location Main Hall",
      "link": "https://drupal-camp2023.den-japan.org/node/34",
      "track": [],
      "speakers": [
        "Dries Buytaert"
      ],
      "video_url": "",
      "full_description": "Video message from Dries Buytaert, Drupal Founder & Acquia CTO.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T04:20:00Z",
      "endTime": "2023-01-21T04:50:00Z",
      "duration": "P30M",
      "title": "Rebirth of OIST 10 years old website with Drupal 9",
      "location": "Location Main Hall",
      "link": "https://drupal-camp2023.den-japan.org/session/s01",
      "track": [
        "special"
      ],
      "speakers": [
        "Chris Wu"
      ],
      "video_url": "",
      "full_description": "OIST is a pioneering graduate university conducting interdisciplinary research. The website was relaunched at the end of 2022, having been built on Drupal 7 more than 10 years ago. The talk covers project management approach and bilingual implementation challenges during the redesign.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T05:00:00Z",
      "endTime": "2023-01-21T05:20:00Z",
      "duration": "P20M",
      "title": "国際農研Webサイトの構築と運用",
      "location": "Location Track A",
      "link": "https://drupal-camp2023.den-japan.org/session/a01",
      "track": [
        "track a"
      ],
      "speakers": [
        "林 賢紀 (Takanori Hayashi)"
      ],
      "video_url": "",
      "full_description": "Introduces the implementation and subsequent management of Drupal as a CMS on the official JIRCAS website (https://www.jircas.go.jp/), covering objectives, background, and operational experience since its 2016 adoption.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T05:00:00Z",
      "endTime": "2023-01-21T05:20:00Z",
      "duration": "P20M",
      "title": "より速いデプロイを求めてチームで取り組む開発者体験の向上",
      "location": "Location Track B",
      "link": "https://drupal-camp2023.den-japan.org/session/b01",
      "track": [
        "track b"
      ],
      "speakers": [
        "小松 高廣 (Takahiro Komatsu)"
      ],
      "video_url": "",
      "full_description": "Explains that reducing deployment costs is necessary for more frequent Drupal application updates and robust app development. Covers using Acquia's Cloud IDE and Code Studio to enhance developer experience and pursue faster team deployment approaches.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T05:00:00Z",
      "endTime": "2023-01-21T05:20:00Z",
      "duration": "P20M",
      "title": "Drupalで進化させる社内ポータルの作り方と事例",
      "location": "Location Track C (Online)",
      "link": "https://drupal-camp2023.den-japan.org/session/c01",
      "track": [
        "track c",
        "online"
      ],
      "speakers": [
        "岸 俊兵 (Kishi Toshuhei)"
      ],
      "video_url": "",
      "full_description": "Presents success stories from consolidating multiple internal portal sites using Drupal, highlighting necessary features and advantages of adopting Drupal for corporate intranet environments.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T05:30:00Z",
      "endTime": "2023-01-21T05:50:00Z",
      "duration": "P20M",
      "title": "国際学会サイトの事例紹介",
      "location": "Location Track A",
      "link": "https://drupal-camp2023.den-japan.org/session/a02",
      "track": [
        "track a"
      ],
      "speakers": [
        "萩原 高行 (Takayuki Hagihara)"
      ],
      "video_url": "",
      "full_description": "Construction case study of a Drupal site for The 19th International Conference on Retinal Proteins (held November 2022). The system enabled all participants and stakeholders to obtain accounts and independently manage conference registration, payments, and presentation abstracts through self-service. The site was built using only no-code site builders and subsequently converted to static HTML for handoff to Canadian administrators.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T05:30:00Z",
      "endTime": "2023-01-21T05:50:00Z",
      "duration": "P20M",
      "title": "DrupalとFastly！～究極の柔軟性と高速性を手に入れよう～",
      "location": "Location Track B",
      "link": "https://drupal-camp2023.den-japan.org/session/b02",
      "track": [
        "track b"
      ],
      "speakers": [
        "加藤 晋平 (Shimpei Kato)"
      ],
      "video_url": "",
      "full_description": "Introduces Fastly's capabilities and demonstrates practical applications when combined with Drupal. Covers what effects are achievable and explains the concepts of flexibility and speed. Also presents other complementary services offered by InfraRed LLC that integrate well with Drupal.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T05:30:00Z",
      "endTime": "2023-01-21T05:50:00Z",
      "duration": "P20M",
      "title": "MAとSFAそしてCMSとの連携について",
      "location": "Location Track C (Online)",
      "link": "https://drupal-camp2023.den-japan.org/session/c02",
      "track": [
        "track c",
        "online"
      ],
      "speakers": [
        "秋山 真咲 (Akiyama Masaki)"
      ],
      "video_url": "",
      "full_description": "Explains how CMS, SFA, and MA systems often operate independently, creating challenges for digital marketing. Rather than undertaking complex custom development, demonstrates how modules and plugins can enable system integration with minimal programming. Provides specific guidance on which modules and plugins to utilize.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T06:00:00Z",
      "endTime": "2023-01-21T06:20:00Z",
      "duration": "P20M",
      "title": "Drupalを始めるあなたへ、豊田支部発刊書籍の紹介",
      "location": "Location Track A",
      "link": "https://drupal-camp2023.den-japan.org/session/a03",
      "track": [
        "track a"
      ],
      "speakers": [
        "小薗井 康志 (Yasushi Osonoi)"
      ],
      "video_url": "",
      "full_description": "Covers 7 books (effectively 4 unique titles) published by Drupal Meetup Toyota chapter, beginning with \"Drupal9 Web開発をはじめる薄い本\" (A Slim Book to Start Drupal 9 Web Development) released December 23, 2020. The speaker outlines chapter overviews targeting those beginning with Drupal or seeking skill advancement.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T06:00:00Z",
      "endTime": "2023-01-21T06:20:00Z",
      "duration": "P20M",
      "title": "W3CSSテーマを利用したシンプルなディストリビューション SQbase",
      "location": "Location Track B",
      "link": "https://drupal-camp2023.den-japan.org/session/b03",
      "track": [
        "track b"
      ],
      "speakers": [
        "白根 健司 (Kenji Shirane)"
      ],
      "video_url": "",
      "full_description": "SQbase is a Drupal distribution featuring simple site configuration and Japanese sample content, offering responsive site construction examples using the W3.CSS framework. The project aims at improving site construction efficiency and serving as training material. Includes installation demonstration and educational resources.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T06:00:00Z",
      "endTime": "2023-01-21T06:20:00Z",
      "duration": "P20M",
      "title": "Drupalにおける検索エンジンSolrの活用",
      "location": "Location Track C (Online)",
      "link": "https://drupal-camp2023.den-japan.org/session/c03",
      "track": [
        "track c",
        "online"
      ],
      "speakers": [
        "真喜屋 篤 (Atsushi Makiya)"
      ],
      "video_url": "",
      "full_description": "Explores how search engines effectively handle large content volumes. Using a corporate product information site as a reference, demonstrates a sample site combining Drupal with Solr, explaining the integration mechanism between Solr and Drupal and the benefits.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T06:35:00Z",
      "endTime": "2023-01-21T06:55:00Z",
      "duration": "P20M",
      "title": "日本企業でも取り組める、新しいDrupalコミュニティへの貢献のカタチ 〜Group, Subgroupモジュール開発におけるANNAIの取り組み〜",
      "location": "Location Track A",
      "link": "https://drupal-camp2023.den-japan.org/session/a04",
      "track": [
        "track a"
      ],
      "speakers": [
        "太田垣 恭子 (Kyoko Otagaki)"
      ],
      "video_url": "",
      "full_description": "Discusses how Japanese companies can contribute to the Drupal community through module development sponsorships. ANNAI shares their experience sponsoring development since 2020, including work by German company Factorial on the Group module and creation of the Subgroup module. Explains the process for sponsoring module development and considerations when commissioning work from companies in different countries.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T06:35:00Z",
      "endTime": "2023-01-21T06:55:00Z",
      "duration": "P20M",
      "title": "エンジニア向けノードのアクセス制限方法まとめ",
      "location": "Location Track B",
      "link": "https://drupal-camp2023.den-japan.org/session/b04",
      "track": [
        "track b"
      ],
      "speakers": [
        "新田 幸子 (Sachiko Nitta)"
      ],
      "video_url": "",
      "full_description": "Introduces methods usable for implementing granular access restrictions on nodes (ノードに対するきめ細かいアクセス制限を行うために使える方法を紹介します).",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T06:35:00Z",
      "endTime": "2023-01-21T06:55:00Z",
      "duration": "P20M",
      "title": "オーストラリアのDrupal事情",
      "location": "Location Track C (Online)",
      "link": "https://drupal-camp2023.den-japan.org/session/c04",
      "track": [
        "track c",
        "online"
      ],
      "speakers": [
        "Ayumi Mizoshiri"
      ],
      "video_url": "",
      "full_description": "Discusses how Drupal is used in Australia and shares case examples.",
      "sponsorIds": ""
    },
    {
      "startTime": "2023-01-21T07:05:00Z",
      "endTime": "2023-01-21T07:25:00Z",
      "duration": "P20M",
      "title": "千葉日報のDrupal活用事例",
      "location": "Location Track A",
      "link": "https://drupal-camp2023.den-japan.org/session/a05",
      "track": [
        "track a"
      ],
      "speakers": [
        "岩嵜 晃 (Akira Iwasaki)"
      ],
      "video_url": "",
      "full_description": "Covers Chiba Nippo's 12-year Drupal implementation history starting with Drupal 6. Details web service content management through Drupal, content distribution destinations, system architecture diagrams, and ongoing migration validation from Drupal 7 to 9, including structural architecture considerations.",
      "sponsorIds": ""
