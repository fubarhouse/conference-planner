    },
    {
      "startTime": "2019-12-07T04:00:00Z",
      "endTime": "2019-12-07T04:20:00Z",
      "duration": "P20M",
      "title": "プログラミングなしで会員制サイトをどこまで構築できそうか追求してみた",
      "location": "Track B – A会議室",
      "link": "https://drupal-camp2019.den-japan.org/sessions/",
      "track": [
        "Track B"
      ],
      "speakers": [
        "萩原 高行"
      ],
      "full_description": "プログラミングなしで会員制サイトをどこまで構築できそうか追求してみた\n\n発表者: 萩原 高行（Ubiquitous Lifestyle Laboratory）\n\nプログラミングを使わずにDrupalで会員制サイトをどこまで構築できるかを検証。Business Rulesモジュール等を活用したノーコード開発の可能性を探る。\n\nSession materials: https://den-japan.org/sites/default/files/den2019presentation/BusinessRules%20at%20DrupalCamp%20DEN.pdf",
      "video_url": "",
      "sponsorIds": ""
    },
