.feed-icon { display: block; overflow: hidden; width: 16px; height: 16px; t=
ext-indent: -9999px; background: url("/web/20210928140428im_/https://drupal=
jam.nl/core/misc/feed.svg") no-repeat; }

button.link { margin: 0px; padding: 0px; cursor: pointer; border: 0px; back=
ground: transparent; font-size: 1em; }

