@charset "utf-8";

html { color: rgb(34, 34, 34); line-height: 1.4; font-size: 10px; }

::selection { background: rgb(179, 212, 252); text-shadow: none; }

hr { display: block; height: 1px; border-width: 1px 0px 0px; border-style: =
solid none none; border-color: rgb(204, 204, 204) currentcolor currentcolor=
; border-image: initial; margin: 1em 0px; padding: 0px; }

audio, canvas, iframe, img, svg, video { vertical-align: middle; }

fieldset { border: 0px; margin: 0px; padding: 0px; }

textarea { resize: vertical; }

.browserupgrade { margin: 0.2em 0px; background: rgb(204, 204, 204); color:=
 rgb(0, 0, 0); padding: 0.2em 0px; }

*, ::before, ::after { box-sizing: border-box; }

body { background: rgb(46, 49, 146); color: rgb(255, 255, 255); font-size: =
1.8rem; font-family: "PT Sans", sans-serif; line-height: 1.4; }

body, html { height: 100%; }

h1, h2, h3, h4, h5 { margin-top: 0px; color: rgb(255, 247, 187); text-align=
: center; }

.block-title { margin-bottom: 1rem; }

a { color: rgb(255, 247, 187); border-bottom: 1px dashed rgb(255, 247, 187)=
; text-decoration: none; }

a:hover { border-bottom: 1px solid rgb(255, 247, 187); }

ul, ol { padding-left: 1.6rem; }

section { padding: 8rem 0px; }

.section--main { background: rgb(85, 164, 219); position: relative; }

.wrap { max-width: 98rem; margin: 0px auto; padding: 0px 3rem; }

.wrap--big { max-width: 120rem; }

.logo { width: 100%; height: 40rem; }

.logo-container { position: fixed; width: 100%; margin-top: 10rem; top: 0px=
; }

p, ul { margin-top: 0px; }

.text-centered { text-align: center; }

.skyline { margin-bottom: -1px; position: relative; z-index: 2; max-width: =
1800px; }

.content-container { margin-top: 60rem; }

.videoWrapper { position: relative; padding-bottom: 56.25%; padding-top: 25=
px; height: 0px; margin-bottom: 2rem; }

.videoWrapper iframe { position: absolute; top: 0px; left: 0px; width: 100%=
; height: 100%; }

.site-footer { padding: 3rem 0px; background: rgb(46, 49, 146); }

.footer__copyright { font-size: 1.4rem; text-align: center; margin-top: 3re=
m; }

.footer__menu-blocks { display: flex; flex-wrap: wrap; justify-content: spa=
ce-around; }

.block-menu { text-align: center; }

.block-menu ul { list-style: none; padding: 0px; }

.block-menu ul li a { display: inline-block; margin-bottom: 1rem; }

.mailchimp-signup { max-width: 40rem; margin: 0px auto 4rem; }

input { padding: 1.5rem; width: 100%; display: block; background: rgb(255, =
255, 255); border: 1px solid rgb(244, 166, 38); text-align: center; }

input[type=3D"submit"] { background: rgb(244, 166, 38); color: rgb(255, 255=
, 255); margin-top: 2rem; cursor: pointer; }

input[type=3D"submit"]:hover { background: rgb(246, 184, 81); }

@keyframes bounce-icon {=20
  0%, 20%, 50%, 80%, 100% { transform: translateY(0px); }
  10% { transform: translateY(0px); }
  20% { transform: translateY(5px); }
  40% { transform: translateY(-15px); }
  60% { transform: translateY(-10px); }
}

.scroll-down { display: none; }

@media (max-width: 767px) {
  .scroll-down { display: block; width: 40px; animation: 2s ease 0s infinit=
e normal none running bounce-icon; position: absolute; top: 100%; margin-to=
p: -70px; left: 50%; margin-left: -20px; }
  .scroll-down i { font-size: 40px; }
}

.border-deco { display: inline-block; position: relative; padding: 6px; ove=
rflow: hidden; transition: background 200ms ease-in-out; border: 2px solid =
rgb(255, 255, 255); }

.border-deco::after { top: 0px; right: -1px; transform: rotate(45deg); tran=
sform-origin: right top; }

.border-deco::before { top: 0px; left: -1px; transform: rotate(-45deg); tra=
nsform-origin: left top; }

a.border-deco, a.border-deco .border-deco-inner { border-color: rgb(255, 24=
7, 187); }

a.border-deco { transition: transform 200ms ease-in-out; }

a.border-deco:hover { transform: scale(1.05); border-style: solid; border-w=
idth: 2px; }

a.border-deco:hover .border-deco-inner { text-decoration: underline; }

.border-deco-inner { padding: 0.5rem 3rem; display: inline-block; font-weig=
ht: bold; border: 2px solid rgb(255, 255, 255); }

.border-deco-inner::after { bottom: -1px; right: -2px; transform: rotate(-4=
5deg); transform-origin: left bottom; }

.border-deco-inner::before { bottom: -1px; left: -2px; transform: rotate(45=
deg); transform-origin: right bottom; }

.border-deco-inner.no-padding { padding: 0px; }

.border-deco::before, .border-deco::after, .border-deco-inner::before, .bor=
der-deco-inner::after { display: block; content: ""; position: absolute; wi=
dth: 2px; height: 11px; }

.border-deco::before, .border-deco::after, .border-deco-inner::before, .bor=
der-deco-inner::after { background: rgb(255, 255, 255); }

.speakers { margin: 4rem 0px; }

.speaker { display: flex; align-items: center; margin-bottom: 2rem; }

.speaker:last-child { margin-bottom: 0px; }

@media (max-width: 520px) {
  .speaker { flex-direction: column; }
}

.speakers--small .speaker { flex-direction: column; }

.speaker__content h3 { text-align: left; }

.speaker__photo { flex: 0 0 200px; width: 200px; margin-bottom: 3rem; }

@media (min-width: 520px) {
  .speaker__photo { margin-bottom: 0px; }
  .speaker__link:nth-child(2n) .speaker__photo { margin-left: 4rem; order: =
2; }
  .speaker__link:nth-child(2n+1) .speaker__photo { margin-right: 4rem; }
}

.speaker__link { color: rgb(255, 255, 255); border-bottom: 0px; display: bl=
ock; margin-bottom: 2rem; }

.speaker__link:hover { border-bottom: 0px; }

.speaker__link:hover .border-deco--light::before, .speaker__link:hover .bor=
der-deco--light::after, .speaker__link:hover .border-deco-inner--light::bef=
