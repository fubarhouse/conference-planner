          <h1 class=3D"title title-shape-green">Baddy Sonja Breidert</h1>
       =20
      <div class=3D"speaker--function">

 =20
 =20
                  CEO and Co-Founder @ 1xINTERNET
         =20
 =20
</div>
    </header>

    <aside class=3D"speaker--aside">
      <div class=3D"speaker--photo">
