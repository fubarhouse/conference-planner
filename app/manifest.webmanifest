{
  "name": "Conference Planner",
  "short_name": "Planner",
  "description": "Browse, plan, and archive community event schedules and trips — offline-capable.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#131614",
