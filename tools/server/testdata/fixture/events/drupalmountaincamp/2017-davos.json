  "sources": [
   {
    "id": "dmc17-schedule",
    "kind": "schedule",
    "url": "https://drupalmountaincamp.ch/schedule",
    "retrievedAt": "2026-08-26",
    "via": {
     "provider": "wayback",
     "timestamp": "20180903160957",
     "captureUrl": "https://web.archive.org/web/20180903160957/https://drupalmountaincamp.ch/schedule"
    },
    "notes": "Captured 2018-09-03 but titled \"Drupal Mountain Camp 2017\" — the site left /schedule on the 2017 programme for eighteen months. Later editions live at /schedule/2019, /schedule/2022 and then a Pretalx instance at event.drupalmountaincamp.ch. A Views listing: one .view-grouping per day, each holding .item-list blocks whose <h3> carries two <time class=\"datetime\"> elements, and whose <li> rows give the title as a link followed by loose text \"- Speaker(s) (Room: X)\". Dates confirmed against a session node that states \"Sat, 02/18/2017 - 11:00\"."
   },
   {
    "id": "dmc17-initiatives",
    "kind": "sessions",
    "url": "https://drupalmountaincamp.ch/sessions/drupal-8-initiatives",
    "retrievedAt": "2026-08-26",
    "via": {
     "provider": "wayback",
     "timestamp": "20180918093431",
     "captureUrl": "https://web.archive.org/web/20180918093431/https://drupalmountaincamp.ch/sessions/drupal-8-initiatives"
    },
    "notes": "⚠️ The ONLY session page that survives with 2017 content. Of the 40 sessions, just 9 slugs were ever captured, and this is the only capture predating the next edition. The site reuses /sessions/<slug> across years, so later captures render a LATER edition under the same URL: /sessions/docker-101 captured 2025-03 is titled \"Drupal Mountain Camp 2025\" and /sessions/api-first-drupal-and-future-cms captured 2021-05 renders as 2022. Never take a session page for this edition without checking its masthead year."
   },
   {
    "id": "dmc17-sponsors",
    "kind": "sponsors",
    "url": "https://drupalmountaincamp.ch/sponsors",
    "retrievedAt": "2026-08-26",
    "via": {
     "provider": "wayback",
     "timestamp": "20180903175423",
     "captureUrl": "https://web.archive.org/web/20180903175423/https://drupalmountaincamp.ch/sponsors"
    },
    "notes": "Seventeen sponsors in five tiers (Gold, Silver, Social Event, Contribution, Individual — the last named nobody). Every logo recovered. Sponsor cards also appear inline on the schedule page, but only this page carries the tier headings. Logo src attributes are ROOT-RELATIVE (\"/sites/default/files/…\"), so they must be prefixed with the host before requesting them from Wayback."
   },
   {
    "id": "dmc17-venue",
    "kind": "venue",
    "url": "https://drupalmountaincamp.ch/davos",
    "retrievedAt": "2026-08-26",
    "via": {
     "provider": "wayback",
     "timestamp": "20180903150523",
     "captureUrl": "https://web.archive.org/web/20180903150523/https://drupalmountaincamp.ch/davos"
    },
    "notes": "Davos Congress (Kongresszentrum), 7270 Davos; entrance \"Haus Wing B - Eingang Nord\"."
   },
   {
    "id": "dmc17-home",
    "kind": "other",
    "url": "https://drupalmountaincamp.ch/",
    "retrievedAt": "2026-08-26",
    "via": {
     "provider": "wayback",
     "timestamp": "20161029192104",
     "captureUrl": "https://web.archive.org/web/20161029192104/https://drupalmountaincamp.ch/"
    },
    "notes": "Announcement capture: \"16 - 19 February 2017, Davos, Switzerland … the first Drupal Mountain Camp\". It also names a predecessor the checklist does not have — \"Drupal Camp Switzerland 2011 in Lucerne\"."
   },
   {
    "id": "dmc17-logo-unconfirmed",
    "kind": "other",
    "url": "https://drupalmountaincamp.ch/themes/beaker/logo.svg",
    "retrievedAt": "2026-08-26",
    "via": {
     "provider": "wayback",
     "timestamp": "20180903160957",
     "captureUrl": "https://web.archive.org/web/20180903160957/https://drupalmountaincamp.ch/themes/beaker/logo.svg"
    },
    "notes": "Recorded but NOT used as the event logo. The site rendered this file as its masthead (alt=\"Home\"), but it sits at /themes/beaker/logo.svg and its own <title> reads \"Beaker Logo\" — Beaker being the Drupal theme. It may be the camp's mark or the theme's default that was never replaced, and the capture gives no way to tell, so event.logo is left empty rather than asserting it."
   }
  ],
