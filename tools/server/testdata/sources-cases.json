{
  "_comment": [
    "The contract between app/js/modules/sources.js and tools/archive/sources.go.",
    "",
    "summarizeSources() and friends now have two implementations — the browser/Node one and a",
    "Go one — which is exactly the drift risk the single-implementation rule in",
    "sources.js exists to prevent. This file is what replaces that rule: BOTH",
    "sides read it and assert against it, so a change to the rule in one language",
    "fails the other's test suite.",
    "",
    "Readers:",
    "  tools/archive/sources_test.go",
    "  app/js/modules/__tests__/sourcesSummaryContract.test.js",
    "",
    "Extend this file when you extend the rule. Adding a case is how you make the",
    "other language implement it."
  ],
  "summaries": [
    {
      "name": "an event with no sources",
      "dataset": {
        "event": {}
      },
      "expected": {
        "count": 0,
        "kinds": {},
        "wayback": false,
        "stated": 0,
        "oldestCapture": null,
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "sources that is not an array is treated as none",
      "dataset": {
        "event": {
          "sources": "nope"
        }
      },
      "expected": {
        "count": 0,
        "kinds": {},
        "wayback": false,
        "stated": 0,
        "oldestCapture": null,
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "kinds are counted in first-seen order, not alphabetically",
      "dataset": {
        "event": {
          "sources": [
            {
              "id": "a",
              "kind": "schedule"
            },
            {
              "id": "b",
              "kind": "sponsors"
            },
            {
              "id": "c",
              "kind": "schedule"
            },
            {
              "id": "d",
              "kind": "video"
            }
          ]
        }
      },
      "expected": {
        "count": 4,
        "kinds": {
          "schedule": 2,
          "sponsors": 1,
          "video": 1
        },
        "kindOrder": [
          "schedule",
          "sponsors",
          "video"
        ],
        "wayback": false,
        "stated": 0,
        "oldestCapture": null,
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "a source with no kind still counts toward the total",
      "dataset": {
        "event": {
          "sources": [
            {
              "id": "a"
            },
            {
              "id": "b",
              "kind": "other"
            }
          ]
        }
      },
      "expected": {
        "count": 2,
        "kinds": {
          "other": 1
        },
        "wayback": false,
        "stated": 0,
        "oldestCapture": null,
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "the oldest wayback capture wins",
      "dataset": {
        "event": {
          "sources": [
            {
              "id": "a",
              "kind": "schedule",
              "via": {
                "provider": "wayback",
                "timestamp": "20130826155852"
              }
            },
            {
              "id": "b",
              "kind": "sponsors",
              "via": {
                "provider": "wayback",
                "timestamp": "20090101000000"
              }
            }
          ]
        }
      },
      "expected": {
        "count": 2,
        "kinds": {
          "schedule": 1,
          "sponsors": 1
        },
        "wayback": true,
        "stated": 0,
        "oldestCapture": "2009-01-01",
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "an unparseable capture stamp does not clear the wayback flag",
      "dataset": {
        "event": {
          "sources": [
            {
              "id": "a",
              "kind": "schedule",
              "via": {
                "provider": "wayback",
                "timestamp": "abc"
              }
            }
          ]
        }
      },
      "expected": {
        "count": 1,
        "kinds": {
          "schedule": 1
        },
        "wayback": true,
        "stated": 0,
        "oldestCapture": null,
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "stated sources are counted separately",
      "dataset": {
        "event": {
          "sources": [
            {
              "id": "a",
              "kind": "stats",
              "via": {
                "provider": "stated"
              }
            },
            {
              "id": "b",
              "kind": "community",
              "via": {
                "provider": "stated"
              }
            },
            {
              "id": "c",
              "kind": "schedule"
            }
          ]
        }
      },
      "expected": {
        "count": 3,
        "kinds": {
          "stats": 1,
          "community": 1,
          "schedule": 1
        },
        "wayback": false,
        "stated": 2,
        "oldestCapture": null,
        "retrievedFrom": null,
        "retrievedTo": null
      }
    },
    {
      "name": "retrievedAt spans the range, and a datetime is cut to its date",
      "dataset": {
        "event": {
          "sources": [
            {
              "id": "a",
              "kind": "schedule",
              "retrievedAt": "2026-04-28"
            },
            {
              "id": "b",
              "kind": "sponsors",
              "retrievedAt": "2020-01-02T10:00:00Z"
            },
            {
              "id": "c",
              "kind": "video",
              "retrievedAt": "2023-06-15"
            }
          ]
        }
      },
      "expected": {
        "count": 3,
        "kinds": {
          "schedule": 1,
          "sponsors": 1,
          "video": 1
        },
        "wayback": false,
        "stated": 0,
        "oldestCapture": null,
        "retrievedFrom": "2020-01-02",
        "retrievedTo": "2026-04-28"
      }
    }
  ],
  "waybackTimestamps": [
