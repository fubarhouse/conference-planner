    },
    {
      "source": {
        "id": "a",
        "verifiedAt": "2026-01-01",
        "verifiedBy": "human",
        "via": {
          "provider": "wayback"
        }
      },
      "tier": "verified",
      "why": "verification outranks the capture"
    }
  ],
  "attribution": [
