# Copy to .env and fill in values. Never commit .env to git.

# ── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_MODE: off | session | multi  (auto-detected if not set)
#   off      — no auth
#   session  — single password, HMAC cookie
#   multi    — per-user passwords, JWT, RBAC (requires DYNAMODB_USERS_TABLE)
# CDNs (CloudFront, Cloudflare, Fastly) sit in front transparently — no app config needed.
AUTH_MODE=session

# Set to false to disable auth without removing other settings.
AUTH_ENABLED=true

# Generate with: node --eval "import('bcryptjs').then(m=>m.default.hash('your-password',12).then(console.log))"
AUTH_PASSWORD_HASH=

# Required to survive server restarts (session mode uses this; multi mode uses JWT_SECRET)
SESSION_SECRET=

# ── Multi-user mode ───────────────────────────────────────────────────────────
# ADMIN_USERNAME + AUTH_PASSWORD_HASH bootstrap the first admin on startup.
# JWT_SECRET signs user tokens; falls back to SESSION_SECRET if unset.
DYNAMODB_USERS_TABLE=
ADMIN_USERNAME=
JWT_SECRET=

# ── S3 Sync ───────────────────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_PREFIX=

# ── AWS credentials ───────────────────────────────────────────────────────────
# For local dev, prefer AWS_PROFILE — avoids storing keys in this file.
# In production (ECS/Lightsail with task role), leave all of these unset.
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-2       # overrides S3_REGION for all AWS clients
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=              # only needed for temporary STS credentials

# ── AWS endpoint overrides ────────────────────────────────────────────────────
# Endpoint is auto-constructed from region (e.g. https://dynamodb.ap-southeast-2.amazonaws.com).
# Override for local dev with DynamoDB Local or LocalStack:
# AWS_ENDPOINT_URL=http://localhost:4566            # global override (LocalStack)
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000   # DynamoDB Local
# AWS_ENDPOINT_URL_S3=http://localhost:9000         # MinIO or LocalStack S3

# ── Content ───────────────────────────────────────────────────────────────────
# WHERE the archive and this installation's state live on disk.
#
# THIS FILE IS THE CANONICAL REFERENCE for that path. `.env` is gitignored, so if
# the two ever disagree, this one is right.
#
# CONTENT_PATH is the normal way to set it: one variable, and the roots below
# derive from it, so the path is written down once rather than three times.
#
#   CONTENT_PATH=../my-content-directory
#     → DATA_ROOT    = <CONTENT_PATH>/public       archive: events/, *.json, caches
#     → IMG_ROOT     = <CONTENT_PATH>/public/img   sponsors/, flickr/, logos/
#     → PRIVATE_ROOT = <CONTENT_PATH>/private      planners/, receipts/,
#                                                  documents/, curation/
#
# Relative values resolve against the REPO ROOT (not the process CWD), so the
# same value works wherever the server is started from. Absolute paths outside the
# repository are supported.
#
CONTENT_PATH=../conference-planner-data

# The three roots individually. Leave them unset unless the layout is not
# public/private — an explicit root overrides whatever CONTENT_PATH would derive.
# With nothing set at all, the app falls back to app/data, app/img and private/.
#
# Note: these cannot be written as ${CONTENT_PATH}/public here. Node's
# `--env-file` does no variable expansion, so it would be read as that literal
# string. The derivation happens in lib/roots.js. (Docker Compose *does*
# interpolate, which is why docker-compose.yml can use ${CONTENT_PATH} directly.)
#
# DATA_ROOT=
# IMG_ROOT=
# PRIVATE_ROOT=
#
# `private/` must never be published: it holds planners, uploaded receipts and
# documents, and the curation ledger's real names. Keep it outside any directory
# that becomes a public repository.
#
# URLs are unaffected by any of this: `/data` and `/img` are the contract the
# datasets and the client depend on, and the server mounts these roots there
# whatever the disk looks like.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# NODE_ENV=production
