# Copy to .env and fill in values. Never commit .env to git.

# ── Auth ──────────────────────────────────────────────────────────────────────
# AUTH_MODE: off | session | multi  (auto-detected if not set)
#   off      — no auth
#   session  — single password, HMAC cookie
#   multi    — per-user passwords, JWT, RBAC (requires DYNAMODB_USERS_TABLE)
# CDNs (CloudFront, Cloudflare, Fastly) sit in front transparently — no app config needed.
AUTH_MODE=session

# Set to false to disable auth without removing other settings.
AUTH_ENABLED=true

# Generate with: node --eval "import('bcryptjs').then(m=>m.default.hash('your-password',12).then(console.log))"
AUTH_PASSWORD_HASH=

# Required to survive server restarts (session mode uses this; multi mode uses JWT_SECRET)
SESSION_SECRET=

# ── Multi-user mode ───────────────────────────────────────────────────────────
# ADMIN_USERNAME + AUTH_PASSWORD_HASH bootstrap the first admin on startup.
# JWT_SECRET signs user tokens; falls back to SESSION_SECRET if unset.
DYNAMODB_USERS_TABLE=
ADMIN_USERNAME=
JWT_SECRET=

# ── S3 Sync ───────────────────────────────────────────────────────────────────
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_PREFIX=

# ── AWS credentials ───────────────────────────────────────────────────────────
# For local dev, prefer AWS_PROFILE — avoids storing keys in this file.
# In production (ECS/Lightsail with task role), leave all of these unset.
# AWS_PROFILE=default
# AWS_REGION=ap-southeast-2       # overrides S3_REGION for all AWS clients
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=              # only needed for temporary STS credentials

# ── AWS endpoint overrides ────────────────────────────────────────────────────
# Endpoint is auto-constructed from region (e.g. https://dynamodb.ap-southeast-2.amazonaws.com).
# Override for local dev with DynamoDB Local or LocalStack:
# AWS_ENDPOINT_URL=http://localhost:4566            # global override (LocalStack)
# AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8000   # DynamoDB Local
# AWS_ENDPOINT_URL_S3=http://localhost:9000         # MinIO or LocalStack S3

# ── Content roots ─────────────────────────────────────────────────────────────
# WHERE content lives on disk. All optional — unset means the layout that has
# always shipped, so an existing install needs no change. Relative values resolve
# against the repo root (not the process CWD), and absolute paths outside the
# repo are supported.
#
# URLs are unaffected: `/data` and `/img` are the contract the datasets and the
# client depend on, and the server mounts these roots there whatever the disk
# looks like.
#
# DATA_ROOT     public archive — events/, sponsors.json, themes.json, caches
# IMG_ROOT      data-owned images — sponsors/, flickr/, logos/
# PRIVATE_ROOT  this installation's state — planners/, receipts/, documents/,
#               curation/. Deliberately outside app/, which is served statically.
#               Point it at a mounted volume in production.
#
# DATA_ROOT=app/data
# IMG_ROOT=app/img
# PRIVATE_ROOT=private

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
# NODE_ENV=production
