  "sessionNotes": {
    "0900-main-stage-state-of-the-word": {
      "attended": true,
      "rating": 5,
      "notes": "Incredible energy. Matt shared growth from 0.7% to 14% of the web. Huge opportunity space for our product. Key quote: 'The GPL is our constitution.'"
    },
    "1030-room-b-building-plugins-right": {
      "attended": true,
      "rating": 4,
      "notes": "Solid walkthrough of the plugin API. Hooks and filters pattern is elegant. Our dev team should watch the recording — directly relevant to our integration work."
    },
    "1330-main-stage-theming-workshop": {
      "attended": false,
      "rating": 0,
      "notes": "Sent Alice to cover this. She has detailed notes. Workshop was oversubscribed — good sign for the ecosystem."
    },
    "1500-room-c-seo-and-wordpress": {
      "attended": true,
      "rating": 3,
      "notes": "Some useful permalink strategy tips but mostly covered ground we already know. The Yoast-style meta approach is worth revisiting in our content pipeline."
    }
  },

